# systemd user unit: ~/.config/systemd/user/bearprint-mcp-tunnel.service
# Enable with: systemctl --user daemon-reload && systemctl --user enable --now bearprint-mcp-tunnel.service
[Unit]
Description=BearPrint MCP server via OpenAI Secure MCP Tunnel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Holds only CONTROL_PLANE_API_KEY=... (mode 600). Add BEARPRINT_URL=... here if
# the BearPrint server is not on localhost:8080.
EnvironmentFile=%h/.config/bearprint-mcp.env
ExecStart=%h/.local/bin/tunnel-client run --profile bearprint
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
